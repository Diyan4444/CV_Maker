{
  "name": "quillfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run copy:pdf-worker && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.test.json --noEmit",
    "check:legal": "tsx scripts/check-legal.ts",
    "verify:summary": "tsx scripts/test-summary.ts",
    "db:apply": "tsx scripts/apply-migrations.ts",
    "db:verify": "tsx scripts/verify-database.ts",
    "copy:pdf-worker": "node scripts/copy-pdf-worker.mjs",
    "postinstall": "npm run copy:pdf-worker"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.75.0",
    "next": "16.4.6",
    "pdfjs-dist": "^6.5.438",
    "postgres": "^4.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.4.6",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/culori": "^4.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "canvas": "^3.2.3",
    "culori": "^4.0.2",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "pdf-parse": "^2.4.5",
    "pdf-to-png-converter": "^4.3.0",
    "playwright": "^1.65.1",
    "postcss": "^8.5.33",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  }
}
